# ============================================================
# Longkedin — Environment Variables Template
# Copy to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://longkedin:longkedin@localhost:5432/longkedin?schema=public
DATABASE_URL_REPLICA=postgresql://longkedin:longkedin@localhost:5433/longkedin?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_URL=amqp://longkedin:longkedin@localhost:5672

# --- S3 Compatible Storage (MinIO for local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RESUMES=longkedin-resumes
S3_BUCKET_RECORDINGS=longkedin-recordings
S3_REGION=us-east-1

# --- AI: DeepSeek (primary, chat/completion) ---
DEEPSEEK_API_KEY=sk-***
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- AI: OpenAI (embedding only — DeepSeek has no embedding API) ---
OPENAI_API_KEY=sk-***
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (optional) ---
ANTHROPIC_API_KEY=sk-ant-***

# --- ElevenLabs (optional, for TTS) ---
ELEVENLABS_API_KEY=***

# --- NextAuth ---
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

# --- OAuth Providers ---
GITHUB_CLIENT_ID=***
GITHUB_CLIENT_SECRET=***
GOOGLE_CLIENT_ID=***
GOOGLE_CLIENT_SECRET=***

# --- Sentry ---
SENTRY_DSN=***
SENTRY_ORG=***
SENTRY_PROJECT=***

# --- Feature Flags ---
FEATURE_VOICE_INTERVIEW=false
FEATURE_JOB_SCRAPING=false
FEATURE_EMAIL_PARSING=false

# --- Application ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WORKER_PORT=8000
LOG_LEVEL=debug
